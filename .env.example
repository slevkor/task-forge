PORT=4000
HOST=127.0.0.1
# Local development defaults to SQLite.
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/taskforge.db
# Production MySQL example (URL-encode special characters in credentials):
# DATABASE_DRIVER=mysql
# DATABASE_URL=mysql://taskforge:password@127.0.0.1:3306/taskforge
JWT_SECRET=replace-with-a-long-random-secret
# Used to encrypt agent API tokens so admins can reveal them later. Defaults to JWT_SECRET when unset.
# TOKEN_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Comma-separated when the API is accessed directly from multiple web origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional in local development because Vite proxies /api to the backend.
# VITE_API_URL=https://api.example.com/api

# --- apps/bridge (task-forge <-> CAO integration, optional) ---
# BRIDGE_PORT=4100
# BRIDGE_SHARED_SECRET=replace-with-a-long-random-secret
# BRIDGE_TASKFORGE_TOKEN=task-forge token scoped task:read,task:update:status,task:update:meta,task:update:notes
# PM_BOT_USER_ID=
# PM_BOT_TOKEN=scoped task:read,task:update:status,task:update:notes
# DEV_BOT_USER_ID=
# DEV_BOT_TOKEN=scoped task:read,task:update:status,task:update:notes,task:update:branch
# REVIEW_BOT_USER_ID=
# REVIEW_BOT_TOKEN=scoped task:read,task:update:status,task:update:notes
# CAO_BIN=cao
# CAO_PROVIDER=claude_code
# No CAO_WORKING_DIRECTORY here on purpose — each project sets its own
# repoPath (project settings in the UI, or PATCH /api/projects/:id). The
# bridge refuses to launch for a project with no repoPath configured.
